<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext HTTP is deliberately still allowed (a self-hosted backend on a LAN has no TLS
  certificate), but it is now explicit and scoped rather than a blanket flag:
    * HTTPS everywhere is always allowed and preferred.
    * Cleartext is permitted for local/private development hosts and any user-entered host,
      which is what the in-app "API address" field accepts.
  Add a domain-config entry here if you ever need to pin a specific host.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
